{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Itmo.Dev.Platform.MessagePersistence": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Npgsql": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Itmo.Dev.Platform.MessagePersistence": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Npgsql": "Warning"
      }
    }
  },
  "Infrastructure": {
    "Persistence": {
      "Postgres": {
        "Host": "localhost",
        "Port": 5432,
        "Database": "postgres",
        "Username": "postgres",
        "Password": "postgres",
        "SslMode": "Prefer",
        "Pooling": true
      }
    }
  },
  "Account": {
    "MaxAmount": "5"
  },
  "Kestrel": {
    "Endpoints": {
      "gRPC": {
        "Url": "http://*:35412",
        "Protocols": "Http2"
      },
      "http": {
        "Url": "http://*:35413",
        "Protocols": "Http1"
      }
    }
  },
  "Presentation": {
    "Kafka": {
      "Host": "127.0.0.1:8001",
      "Consumers": {
        "ApprovalResult": {
          "IsDisabled": false,
          "Topic": "approval_result",
          "Group": "bank-system-api.approval-result"
        }
      },
      "Producers": {
        "AccountCreated": {
          "Topic": "account_created",
          "Outbox": {
            "BatchSize": 100,
            "PollingDelay": "00:00:00.500"
          }
        },
        "InvoiceCreated": {
          "Topic": "invoice_created",
          "Outbox": {
            "BatchSize": 100,
            "PollingDelay": "00:00:00.500"
          }
        }
      }
    }
  },
  "MessagePersistence": {
    "Publisher": {
      "Default": {
        "BatchSize": 100,
        "PollingDelay": "00:00:00.500"
      }
    },
    "Postgres": {
      "SchemaName": "message_persistence"
    }
  }
}
